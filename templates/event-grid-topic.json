{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "topicName": {
            "type": "string",
            "metadata": {
                "description": "Name of the Event Grid custom topic to create."
            }
        },
        "location": {
            "type": "string",
            "defaultValue": "[resourceGroup().location]",
            "metadata": {
                "description": "Location of the topic. For Defender malware scan results this must match the region of the storage account whose results it receives."
            }
        },
        "inputSchema": {
            "type": "string",
            "defaultValue": "EventGridSchema",
            "allowedValues": [
                "EventGridSchema",
                "CloudEventSchemaV1_0",
                "CustomEventSchema"
            ],
            "metadata": {
                "description": "Schema in which events are published to the topic."
            }
        },
        "publicNetworkAccess": {
            "type": "string",
            "defaultValue": "Enabled",
            "allowedValues": [
                "Enabled",
                "Disabled"
            ],
            "metadata": {
                "description": "Whether the topic accepts traffic from public IPs. Defender for Storage cannot publish to a topic that only allows private endpoints, so this must be Enabled for malware scan results."
            }
        }
    },
    "resources": [
        {
            "type": "Microsoft.EventGrid/topics",
            "apiVersion": "2022-06-15",
            "name": "[parameters('topicName')]",
            "location": "[parameters('location')]",
            "properties": {
                "inputSchema": "[parameters('inputSchema')]",
                "publicNetworkAccess": "[parameters('publicNetworkAccess')]"
            }
        }
    ],
    "outputs": {
        "topicName": {
            "type": "string",
            "value": "[parameters('topicName')]"
        },
        "topicResourceId": {
            "type": "string",
            "value": "[resourceId('Microsoft.EventGrid/topics', parameters('topicName'))]"
        }
    }
}
