{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "topicName": {
            "type": "string",
            "metadata": {
                "description": "Name of the existing Event Grid custom topic to subscribe to. The topic must already exist in the resource group this template is deployed into."
            }
        },
        "eventSubscriptionName": {
            "type": "string",
            "metadata": {
                "description": "Name of the event subscription to create on the topic."
            }
        },
        "functionAppName": {
            "type": "string",
            "metadata": {
                "description": "Name of the Function App that hosts the event handler."
            }
        },
        "functionName": {
            "type": "string",
            "metadata": {
                "description": "Name of the function (within the Function App) that handles the events. The function must be deployed before this subscription is created."
            }
        },
        "functionResourceGroup": {
            "type": "string",
            "metadata": {
                "description": "Resource group containing the Function App."
            }
        },
        "functionSubscriptionId": {
            "type": "string",
            "defaultValue": "[subscription().subscriptionId]",
            "metadata": {
                "description": "Subscription ID containing the Function App. Defaults to the current subscription."
            }
        },
        "includedEventTypes": {
            "type": "array",
            "metadata": {
                "description": "Event types this subscription listens for (for example [\"Microsoft.Security.MalwareScanningResult\"])."
            }
        },
        "maxEventsPerBatch": {
            "type": "int",
            "defaultValue": 1,
            "metadata": {
                "description": "Maximum number of events to deliver per batch to the Azure Function."
            }
        },
        "preferredBatchSizeInKilobytes": {
            "type": "int",
            "defaultValue": 64,
            "metadata": {
                "description": "Preferred batch size in kilobytes."
            }
        },
        "maxDeliveryAttempts": {
            "type": "int",
            "defaultValue": 30,
            "metadata": {
                "description": "Maximum number of delivery retry attempts before an event is dead-lettered or dropped."
            }
        },
        "eventTimeToLiveInMinutes": {
            "type": "int",
            "defaultValue": 1440,
            "metadata": {
                "description": "Time-to-live for events in minutes before they are dropped or dead-lettered."
            }
        },
        "eventDeliverySchema": {
            "type": "string",
            "defaultValue": "EventGridSchema",
            "metadata": {
                "description": "Delivery schema for events. Must match what the handler expects (EventGridTrigger functions expect EventGridSchema)."
            }
        },
        "enableDeadLettering": {
            "type": "bool",
            "defaultValue": false,
            "metadata": {
                "description": "Whether to enable dead-lettering of undelivered events to a storage blob container."
            }
        },
        "deadLetterStorageAccountResourceId": {
            "type": "string",
            "defaultValue": "",
            "metadata": {
                "description": "Resource ID of the storage account used for dead-lettering. Required when enableDeadLettering is true."
            }
        },
        "deadLetterContainerName": {
            "type": "string",
            "defaultValue": "eventgrid-deadletter",
            "metadata": {
                "description": "Name of the blob container used for dead-lettered events."
            }
        }
    },
    "variables": {
        "subscriptionPropertiesBase": {
            "destination": {
                "endpointType": "AzureFunction",
                "properties": {
                    "resourceId": "[resourceId(parameters('functionSubscriptionId'), parameters('functionResourceGroup'), 'Microsoft.Web/sites/functions', parameters('functionAppName'), parameters('functionName'))]",
                    "maxEventsPerBatch": "[parameters('maxEventsPerBatch')]",
                    "preferredBatchSizeInKilobytes": "[parameters('preferredBatchSizeInKilobytes')]"
                }
            },
            "filter": {
                "includedEventTypes": "[parameters('includedEventTypes')]"
            },
            "eventDeliverySchema": "[parameters('eventDeliverySchema')]",
            "retryPolicy": {
                "maxDeliveryAttempts": "[parameters('maxDeliveryAttempts')]",
                "eventTimeToLiveInMinutes": "[parameters('eventTimeToLiveInMinutes')]"
            }
        },
        "deadLetterDestination": {
            "endpointType": "StorageBlob",
            "properties": {
                "resourceId": "[parameters('deadLetterStorageAccountResourceId')]",
                "blobContainerName": "[parameters('deadLetterContainerName')]"
            }
        },
        "subscriptionPropertiesWithDeadLetter": "[union(variables('subscriptionPropertiesBase'), createObject('deadLetterDestination', variables('deadLetterDestination')))]"
    },
    "resources": [
        {
            "type": "Microsoft.EventGrid/topics/eventSubscriptions",
            "apiVersion": "2022-06-15",
            "name": "[concat(parameters('topicName'), '/', parameters('eventSubscriptionName'))]",
            "properties": "[if(parameters('enableDeadLettering'), variables('subscriptionPropertiesWithDeadLetter'), variables('subscriptionPropertiesBase'))]"
        }
    ],
    "outputs": {
        "eventSubscriptionName": {
            "type": "string",
            "value": "[parameters('eventSubscriptionName')]"
        }
    }
}
