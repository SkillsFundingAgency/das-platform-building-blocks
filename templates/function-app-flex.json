{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "functionAppName": {
      "type": "string"
    },
    "flexConsumptionPlanName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Flex Consumption (FC1) plan created for the function app. A Flex Consumption plan can only host one function app."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "storageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Existing storage account in the same resource group. The deployment package container is created in it."
      }
    },
    "deploymentContainerName": {
      "type": "string",
      "defaultValue": "app-package",
      "metadata": {
        "description": "Blob container the deployment package is uploaded to. Created if it doesn't exist."
      }
    },
    "deploymentStorageAuthenticationType": {
      "type": "string",
      "defaultValue": "StorageAccountConnectionString",
      "allowedValues": [
        "StorageAccountConnectionString",
        "SystemAssignedIdentity"
      ],
      "metadata": {
        "description": "How the platform reads the deployment container. SystemAssignedIdentity also assigns the app's identity Storage Blob Data Contributor on the storage account."
      }
    },
    "deploymentStorageConnectionStringName": {
      "type": "string",
      "defaultValue": "DEPLOYMENT_STORAGE_CONNECTION_STRING",
      "metadata": {
        "description": "Name of the app setting holding the storage connection string. Only used with StorageAccountConnectionString; the setting must be included in functionAppAppSettings."
      }
    },
    "functionAppAppSettings": {
      "type": "secureObject",
      "defaultValue": {
        "array": []
      },
      "metadata": {
        "description": "Don't include FUNCTIONS_EXTENSION_VERSION, FUNCTIONS_WORKER_RUNTIME or WEBSITE_RUN_FROM_PACKAGE; they're deprecated on Flex Consumption. See https://learn.microsoft.com/azure/azure-functions/functions-app-settings#flex-consumption-plan-deprecations"
      }
    },
    "ipSecurityRestrictions": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Must use this format: https://learn.microsoft.com/en-us/azure/templates/microsoft.web/sites#ipsecurityrestriction"
      }
    },
    "subnetResourceId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Resource ID of the subnet used for vNet integration. The subnet must be delegated to Microsoft.App/environments, and the Microsoft.App resource provider must be registered in the subscription."
      }
    },
    "runtimeName": {
      "type": "string",
      "defaultValue": "dotnet-isolated",
      "allowedValues": [
        "dotnet-isolated",
        "node",
        "python",
        "java",
        "powershell",
        "custom"
      ]
    },
    "runtimeVersion": {
      "type": "string",
      "defaultValue": "10.0",
      "metadata": {
        "description": "Language stack version, e.g. 8.0 or 10.0 for dotnet-isolated. The in-process .NET model isn't supported on Flex Consumption."
      }
    },
    "maximumInstanceCount": {
      "type": "int",
      "defaultValue": 100,
      "minValue": 1,
      "maxValue": 1000,
      "metadata": {
        "description": "Maximum on-demand instances, applied to each per-function scale group."
      }
    },
    "instanceMemoryMB": {
      "type": "int",
      "defaultValue": 2048,
      "allowedValues": [
        512,
        2048,
        4096
      ]
    },
    "alwaysReady": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Always ready instances per scale group, e.g. [{\"name\": \"durable\", \"instanceCount\": 1}]. Group names are http, blob, durable or function:<FunctionName>. Billed while idle."
      }
    }
  },
  "variables": {
    "functionAppApiVersion": "2023-12-01",
    "useConnectionString": "[equals(parameters('deploymentStorageAuthenticationType'), 'StorageAccountConnectionString')]",
    "storageBlobDataContributorRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'ba92f5b4-2d11-453d-a403-e96b0029c9fe')]",
    "deploymentStorageAuthentication": "[if(variables('useConnectionString'), createObject('type', 'StorageAccountConnectionString', 'storageAccountConnectionStringName', parameters('deploymentStorageConnectionStringName')), createObject('type', 'SystemAssignedIdentity'))]",
    "baseSiteProperties": {
      "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('flexConsumptionPlanName'))]",
      "clientAffinityEnabled": false,
      "httpsOnly": true,
      "siteConfig": {
        "appSettings": "[parameters('functionAppAppSettings').array]",
        "ipSecurityRestrictions": "[parameters('ipSecurityRestrictions')]",
        "minTlsVersion": "1.2"
      },
      "functionAppConfig": {
        "deployment": {
          "storage": {
            "type": "blobContainer",
            "value": "[concat('https://', parameters('storageAccountName'), '.blob.', environment().suffixes.storage, '/', parameters('deploymentContainerName'))]",
            "authentication": "[variables('deploymentStorageAuthentication')]"
          }
        },
        "scaleAndConcurrency": {
          "maximumInstanceCount": "[parameters('maximumInstanceCount')]",
          "instanceMemoryMB": "[parameters('instanceMemoryMB')]",
          "alwaysReady": "[parameters('alwaysReady')]"
        },
        "runtime": {
          "name": "[parameters('runtimeName')]",
          "version": "[parameters('runtimeVersion')]"
        }
      }
    },
    "siteProperties": "[if(greater(length(parameters('subnetResourceId')), 0), union(variables('baseSiteProperties'), createObject('virtualNetworkSubnetId', parameters('subnetResourceId'))), variables('baseSiteProperties'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[concat(parameters('storageAccountName'), '/default/', parameters('deploymentContainerName'))]",
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "[variables('functionAppApiVersion')]",
      "name": "[parameters('flexConsumptionPlanName')]",
      "location": "[parameters('location')]",
      "kind": "functionapp",
      "sku": {
        "name": "FC1",
        "tier": "FlexConsumption"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "[variables('functionAppApiVersion')]",
      "name": "[parameters('functionAppName')]",
      "location": "[parameters('location')]",
      "kind": "functionapp,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": "[variables('siteProperties')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', parameters('flexConsumptionPlanName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', parameters('storageAccountName'), 'default', parameters('deploymentContainerName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "condition": "[not(variables('useConnectionString'))]",
      "apiVersion": "2022-04-01",
      "scope": "[concat('Microsoft.Storage/storageAccounts/', parameters('storageAccountName'))]",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), parameters('functionAppName'), variables('storageBlobDataContributorRoleId'))]",
      "properties": {
        "roleDefinitionId": "[variables('storageBlobDataContributorRoleId')]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', parameters('functionAppName')), variables('functionAppApiVersion'), 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('functionAppName'))]"
      ]
    }
  ],
  "outputs": {
    "managedServiceIdentityId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('functionAppName')), variables('functionAppApiVersion'), 'Full').identity.principalId]"
    }
  }
}
