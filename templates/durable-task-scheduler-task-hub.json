{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "schedulerName": {
      "type": "string",
      "metadata": {
        "description": "Name of an existing scheduler in the resource group this template is deployed to."
      }
    },
    "taskHubName": {
      "type": "string"
    }
  },
  "resources": [
    {
      "type": "Microsoft.DurableTask/schedulers/taskHubs",
      "apiVersion": "2026-02-01",
      "name": "[concat(parameters('schedulerName'), '/', parameters('taskHubName'))]",
      "properties": {}
    }
  ],
  "outputs": {
    "SchedulerName": {
      "type": "string",
      "value": "[parameters('schedulerName')]"
    },
    "SchedulerEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.DurableTask/schedulers', parameters('schedulerName')), '2026-02-01').endpoint]"
    },
    "TaskHubName": {
      "type": "string",
      "value": "[parameters('taskHubName')]"
    }
  }
}
